<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جدول ومُنبّه الدكتورة أميرة محمد 🌸🩺</title>
    <!-- خط Tajawal للعنوانين و Cairo للنصوص -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@500;700;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #1a0b2e 0%, #2b1055 40%, #4c1d95 70%, #701a75 100%);
            --card-glass: rgba(255, 255, 255, 0.08);
            --card-border: rgba(255, 255, 255, 0.18);
            --pink-accent: #f472b6;
            --purple-accent: #c084fc;
            --gold-accent: #fde047;
            --text-main: #f8fafc;
            --text-sub: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg-gradient);
            background-attachment: fixed;
            color: var(--text-main);
            padding: 25px 12px;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* --- خلفية البالونات المتطايرة --- */
        .balloon-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .balloon {
            position: absolute;
            bottom: -100px;
            opacity: 0.7;
            animation: floatUp 14s linear infinite;
            font-size: 2.2rem;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 0.8; }
            50% { opacity: 0.9; }
            100% { transform: translateY(-120vh) rotate(360deg); opacity: 0; }
        }

        .main-wrapper {
            max-width: 850px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        /* --- الهيدر والرسالة الترحيبية --- */
        .header-card {
            background: var(--card-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 28px 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            margin-bottom: 25px;
            position: relative;
        }

        .badge-tag {
            display: inline-block;
            background: linear-gradient(90deg, #ec4899, #a855f7);
            color: #fff;
            padding: 6px 20px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4);
            margin-bottom: 12px;
        }

        .header-card h1 {
            font-family: 'Tajawal', sans-serif;
            font-size: 2.2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #ffffff, #f472b6, #e9d5ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .header-card p {
            color: var(--text-sub);
            font-size: 1.05rem;
        }

        /* --- قسم المنبه والتحفيز --- */
        .control-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }

        .control-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 18px;
            text-align: center;
        }

        .control-card h3 {
            font-size: 1.1rem;
            color: var(--pink-accent);
            margin-bottom: 10px;
        }

        .btn-action {
            background: linear-gradient(90deg, #a855f7, #ec4899);
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 12px;
            font-family: 'Cairo', sans-serif;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
        }

        .btn-action:hover {
            transform: translateY(-2deg);
            box-shadow: 0 6px 18px rgba(168, 85, 247, 0.5);
        }

        /* --- بطاقات أيام الأسبوع --- */
        .schedule-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .day-card {
            background: var(--card-glass);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.25);
            position: relative;
        }

        .day-card.today-active {
            border: 2px solid var(--gold-accent);
            box-shadow: 0 0 25px rgba(253, 224, 71, 0.3);
        }

        .today-badge {
            display: none;
            background: var(--gold-accent);
            color: #1e1b4b;
            font-size: 0.75rem;
            font-weight: 800;
            padding: 2px 10px;
            border-radius: 10px;
            margin-right: 8px;
        }

        .day-card.today-active .today-badge {
            display: inline-block;
        }

        .day-header {
            font-family: 'Tajawal', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .task-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .task-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            cursor: pointer;
        }

        .task-item:hover {
            background: rgba(255, 255, 255, 0.09);
        }

        .task-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .check-box {
            width: 18px;
            height: 18px;
            border: 2px solid var(--pink-accent);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .task-item.done {
            opacity: 0.5;
            background: rgba(0, 0, 0, 0.2);
        }

        .task-item.done .task-text {
            text-decoration: line-through;
            color: var(--text-sub);
        }

        .task-item.done .check-box {
            background: var(--pink-accent);
        }

        .task-item.done .check-box::after {
            content: '✓';
            color: white;
            font-size: 11px;
            font-weight: bold;
        }

        .time-pill {
            background: rgba(192, 132, 252, 0.15);
            color: #e9d5ff;
            border: 1px solid rgba(192, 132, 252, 0.3);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            direction: ltr;
        }

        .sleep-row {
            background: rgba(251, 146, 60, 0.15);
            border: 1px solid rgba(251, 146, 60, 0.3);
            justify-content: center;
            font-weight: 700;
            color: #fed7aa;
        }

        /* --- نافذة المنبه المنبثقة (Popup) --- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-box {
            background: linear-gradient(135deg, #2e1065, #581c87);
            border: 2px solid var(--pink-accent);
            border-radius: 24px;
            padding: 30px 25px;
            max-width: 420px;
            width: 90%;
            text-align: center;
            box-shadow: 0 20px 50px rgba(244, 114, 182, 0.4);
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-box {
            transform: scale(1);
        }

        .modal-box h2 {
            font-size: 1.8rem;
            color: var(--gold-accent);
            margin-bottom: 10px;
        }

        .modal-box p {
            font-size: 1.1rem;
            color: #f1f5f9;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        @media (max-width: 600px) {
            .control-box { grid-template-columns: 1fr; }
            .task-item { flex-direction: column; align-items: flex-start; gap: 6px; }
            .time-pill { align-self: flex-end; }
        }
    </style>
</head>
<body>

    <!-- البالونات المتطايرة في الخلفية -->
    <div class="balloon-container" id="balloonContainer"></div>

    <div class="main-wrapper">

        <!-- الهيدر -->
        <div class="header-card">
            <span class="badge-tag">🎓 الصف الثاني الثانوي</span>
            <h1>جدول ومُنبّه الدكتورة أميرة محمد 🌸🩺</h1>
            <p>«كل دقيقة تدرسين فيها اليوم هي خطوة تقربكِ نحو الرداء الأبيض!» ✨</p>
        </div>

        <!-- أدوات المنبه والرسائل -->
        <div class="control-box">
            <div class="control-card">
                <h3>🔔 منبه المذاكرة الذكي</h3>
                <button class="btn-action" onclick="enableAlarmSound()">تفعيل صوت المنبه ⏰</button>
            </div>
            <div class="control-card">
                <h3>💌 رسالة تشجيعية</h3>
                <button class="btn-action" onclick="showRandomQuote()">جرعة تحفيز جديدة 🌸</button>
            </div>
        </div>

        <!-- الجدول الدراسي مرتب بأيام الأسبوع الصحيحة -->
        <div class="schedule-grid">

            <!-- السبت -->
            <div class="day-card" data-day="Saturday">
                <div class="day-header">
                    <span>السبت 🎈 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل أو مذاكرة فيزياء ⚡</span></div><span class="time-pill">8:00 To 11:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة online English 🇬🇧</span></div><span class="time-pill">12:00 To 3:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">المساعدة في البيت 🏠</span></div><span class="time-pill">3:00 To 5:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة online تاريخ 🏛️</span></div><span class="time-pill">5:00 To 8:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">محاضرة العربي 📚</span></div><span class="time-pill">8:30 To 12:00</span></li>
                    <li class="task-item sleep-row">💤 وقت النوم والراحة</li>
                </ul>
            </div>

            <!-- الأحد -->
            <div class="day-card" data-day="Sunday">
                <div class="day-header">
                    <span>الأحد 🌸 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات نحو أو نحو عربي 📝</span></div><span class="time-pill">8:00 To 10:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات على مادة 🎯</span></div><span class="time-pill">11:00 To 1:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">English 🇬🇧</span></div><span class="time-pill">1:30 To 4:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">درس متراجم English 📖</span></div><span class="time-pill">5:00 To 7:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">Test فيزياء ⚡🧪</span></div><span class="time-pill">8:00 To 10:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل ومراجعة على ما سبق تاريخ 🏛️</span></div><span class="time-pill">10:00 To 12:00</span></li>
                    <li class="task-item sleep-row">💤 وقت النوم والراحة</li>
                </ul>
            </div>

            <!-- الاثنين -->
            <div class="day-card" data-day="Monday">
                <div class="day-header">
                    <span>الاثنين ✨ <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة online English 🇬🇧</span></div><span class="time-pill">8:00 To 12:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">محاضرة الفيزياء ⚡</span></div><span class="time-pill">1:00 To 4:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات على مادة 📝</span></div><span class="time-pill">5:00 To 7:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">عربي نحو 📚</span></div><span class="time-pill">7:30 To 10:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة تاريخ 🏛️</span></div><span class="time-pill">10:00 To 1:00</span></li>
                    <li class="task-item sleep-row">💤 وقت النوم والراحة</li>
                </ul>
            </div>

            <!-- الثلاثاء -->
            <div class="day-card" data-day="Tuesday">
                <div class="day-header">
                    <span>الثلاثاء 💖 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل على منهج التاريخ 🏛️</span></div><span class="time-pill">8:00 To 11:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل على محاضرة الفيزياء ⚡</span></div><span class="time-pill">12:00 To 3:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">المساعدة في البيت 🏠</span></div><span class="time-pill">3:00 To 5:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حفظ كلمات English 🇬🇧</span></div><span class="time-pill">5:00 To 9:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل الروائع أدب 📜</span></div><span class="time-pill">9:30 To 1:00</span></li>
                    <li class="task-item sleep-row">💤 وقت النوم والراحة</li>
                </ul>
            </div>

            <!-- الأربعاء -->
            <div class="day-card" data-day="Wednesday">
                <div class="day-header">
                    <span>الأربعاء 🩺 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مراجعة على مادة 🔄</span></div><span class="time-pill">8:00 To 10:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل ومذاكرة Grammar 🇬🇧</span></div><span class="time-pill">10:00 To 1:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">استراحة + المساعدة Home 🏠</span></div><span class="time-pill">1:00 To 2:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات بلاغة ✍️</span></div><span class="time-pill">3:00 To 4:30</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">درس برة English 🇬🇧</span></div><span class="time-pill">5:00 To 7:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">محاضرة + Test الفيزياء ⚡</span></div><span class="time-pill">8:00 To 11:00</span></li>
                </ul>
            </div>

            <!-- الخميس -->
            <div class="day-card" data-day="Thursday">
                <div class="day-header">
                    <span>الخميس 🌟 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة online English 🇬🇧</span></div><span class="time-pill">8:00 To 12:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مذاكرة فيزياء ⚡</span></div><span class="time-pill">1:00 To 4:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">استراحة ☕</span></div><span class="time-pill">4:00 To 5:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">تاريخ 🏛️</span></div><span class="time-pill">5:00 To 8:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">مراجعة فروع العربي 📚</span></div><span class="time-pill">8:30 To 12:00</span></li>
                </ul>
            </div>

            <!-- الجمعة -->
            <div class="day-card" data-day="Friday">
                <div class="day-header">
                    <span>الجمعة 🕌 <span class="today-badge">اليوم الحالي</span></span>
                </div>
                <ul class="task-list">
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات فيزياء ⚡</span></div><span class="time-pill">8:00 To 11:00</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">حل تدريبات عربي 📚</span></div><span class="time-pill">1:00 To 3:30</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">English 🇬🇧</span></div><span class="time-pill">5:00 To 8:30</span></li>
                    <li class="task-item" onclick="toggleTask(this)"><div class="task-left"><div class="check-box"></div><span class="task-text">تاريخ 🏛️</span></div><span class="time-pill">9:00 To 12:00</span></li>
                    <li class="task-item sleep-row">💤 وقت النوم والراحة</li>
                </ul>
            </div>

        </div>
    </div>

    <!-- النافذة المنبثقة للمنبه والرسائل -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-box">
            <div style="font-size: 3rem; margin-bottom: 10px;">⏰🌸</div>
            <h2 id="modalTitle">حان وقت المذاكرة!</h2>
            <p id="modalMsg">يلا يا دكتورة أميرة، جهزي أدواتك وابدئي خطوة جديدة بثقة ونجاح!</p>
            <button class="btn-action" onclick="closeModal()">تم، جهزت! 💖</button>
        </div>
    </div>

    <script>
        // 1. توليد البالونات المتطايرة برفق وحنان
        const balloonContainer = document.getElementById('balloonContainer');
        const icons = ['🎈', '🌸', '💖', '✨', '🩺', '📚', '⭐'];
        
        for (let i = 0; i < 18; i++) {
            let el = document.createElement('div');
            el.className = 'balloon';
            el.innerHTML = icons[Math.floor(Math.random() * icons.length)];
            el.style.left = Math.random() * 95 + '%';
            el.style.animationDelay = (Math.random() * 12) + 's';
            el.style.animationDuration = (10 + Math.random() * 8) + 's';
            balloonContainer.appendChild(el);
        }

        // 2. إنجاز المهام عند الضغط
        function toggleTask(element) {
            element.classList.toggle('done');
        }

        // 3. تحديد اليوم الحالي تلقائياً بأعلى دقة
        const daysOrder = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        const currentDay = daysOrder[new Date().getDay()];
        const todayCard = document.querySelector(`.day-card[data-day="${currentDay}"]`);
        if (todayCard) {
            todayCard.classList.add('today-active');
        }

        // 4. نغمة الصوت للمنبه (Web Audio API)
        let audioCtx;
        function enableAlarmSound() {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            playChimeSound();
            showCustomModal("تم تفعيل المنبه بنجاح! 🔔", "سيعمل المنبه بنغمة لطيفة تذكرك بالمذاكرة تلقائياً يا دكتورة أميرة 💖");
        }

        function playChimeSound() {
            if (!audioCtx) return;
            const now = audioCtx.currentTime;
            
            // نغمة هادئة متعددة النغمات
            [261.63, 329.63, 392.00, 523.25].forEach((freq, index) => {
                let osc = audioCtx.createOscillator();
                let gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.1, now + index * 0.15);
                gain.gain.exponentialRampToValueAtTime(0.001, now + index * 0.15 + 0.8);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now + index * 0.15);
                osc.stop(now + index * 0.15 + 0.8);
            });
        }

        // 5. الرسائل التحفيزية العشوائية
        const quotes = [
            "يا دكتورة أميرة، التعب يزول والنجاح يبقى للأبد! واصلي يا بطلة 🌸",
            "كل مادة تكتمل اليوم هي جزء من حلمكِ الكبير الذي يقترب أكثر 🩺✨",
            "ثقي بنفسكِ وبقدرتكِ على التفوق، أنتِ قدها وزيادة! 💕",
            "لا تضغطي على نفسكِ، خذي نفساً عميقاً واستمتعي برحلة التعلم 📖💖",
            "يا أميرة، مستقبل مشرق بانتظاركِ.. خطوة واحدة كل يوم تكفي! 👑"
        ];

        function showRandomQuote() {
            let randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            showCustomModal("رسالة تشجيعية لكِ 💌", randomQuote);
        }

        // 6. التحكم بالنافذة المنبثقة
        function showCustomModal(title, msg) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMsg').innerText = msg;
            document.getElementById('modalOverlay').classList.add('active');
            playChimeSound();
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('active');
        }
    </script>
</body>
</html>
